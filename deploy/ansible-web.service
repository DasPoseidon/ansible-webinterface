# systemd-Unit fuer das Ansible-Webinterface.
#
# Installation:
#   cp <installationsverzeichnis>/deploy/ansible-web.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now ansible-web
#
# Liegt die Anwendung nicht unter /root/ansible-web, ist genau EINE Zeile
# anzupassen: ExecStart. Das Startskript leitet daraus alles Weitere ab -
# Arbeitsverzeichnis, venv und Konfiguration liegen daneben.

[Unit]
Description=Ansible-Webinterface
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=root

# Der einzige Pfad in dieser Datei.
ExecStart=/root/ansible-web/bin/ansible-web-serve

# Eine andere Konfigurationsdatei als config.yaml neben dem Startskript:
# Environment=ANSIBLE_WEB_CONFIG=/etc/ansible-web.yaml

Restart=on-failure
RestartSec=5s

# Laufende Playbooks sollen sich beim Beenden noch aufraeumen koennen.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ansible-web

[Install]
WantedBy=multi-user.target
